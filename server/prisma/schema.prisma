generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id @default(uuid())
  email                String                   @unique
  password             String
  username             String?                  @unique
  isVerified           Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  role                 UserRole                 @default(CLIENT)
  coClient             CoClient?
  depositRequests      DepositRequest[]
  pushSubscriptions    PushSubscription[]
  likes                UserLike[]
  categoryLinks        ProductCategory[]
  subCategoryLinks     ProductSubCategory[]
  subSubCategory1Links ProductSubSubCategory1[]
  subSubCategory2Links ProductSubSubCategory2[]
  subSubCategory3Links ProductSubSubCategory3[]

  @@map("users")
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  User       User?    @relation(fields: [userId], references: [id])
  userId     String?

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductSubCategory {
  productId     String
  subCategoryId String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  User          User?       @relation(fields: [userId], references: [id])
  userId        String?

  @@id([productId, subCategoryId])
  @@index([subCategoryId])
  @@map("product_sub_categories")
}

model ProductSubSubCategory1 {
  productId        String
  subSubCategoryId String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  subSubCategory   SubSubCategory1 @relation(fields: [subSubCategoryId], references: [id], onDelete: Cascade)
  User             User?           @relation(fields: [userId], references: [id])
  userId           String?

  @@id([productId, subSubCategoryId])
  @@index([subSubCategoryId])
  @@map("product_sub_sub_categories_1")
}

model ProductSubSubCategory2 {
  productId        String
  subSubCategoryId String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  subSubCategory   SubSubCategory2 @relation(fields: [subSubCategoryId], references: [id], onDelete: Cascade)
  User             User?           @relation(fields: [userId], references: [id])
  userId           String?

  @@id([productId, subSubCategoryId])
  @@index([subSubCategoryId])
  @@map("product_sub_sub_categories_2")
}

model ProductSubSubCategory3 {
  productId        String
  subSubCategoryId String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  subSubCategory   SubSubCategory3 @relation(fields: [subSubCategoryId], references: [id], onDelete: Cascade)
  User             User?           @relation(fields: [userId], references: [id])
  userId           String?

  @@id([productId, subSubCategoryId])
  @@index([subSubCategoryId])
  @@map("product_sub_sub_categories_3")
}

model PendingUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  username     String?
  codeHash     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pending_users")
}

model UserLike {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Client {
  id             String          @id @default(uuid())
  firstName      String
  lastName       String
  address        String
  email          String          @unique
  phoneNumber    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  commandDetails CommandDetail[]

  @@map("clients")
}

model CoClient {
  id              String           @id @default(uuid())
  firstName       String
  lastName        String
  address         String
  email           String           @unique
  phoneNumber     String
  RIB             String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userId          String?          @unique
  user            User?            @relation(fields: [userId], references: [id])
  commandDetails  CommandDetail[]
  depositRequests DepositRequest[]
  products        Product[]

  @@map("co_clients")
}

model Category {
  id            String            @id @default(uuid())
  categoryName  String            @unique
  description   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  icon          String?
  coverDoc      String?
  products      Product[]
  productLinks  ProductCategory[]
  subCategories SubCategory[]

  @@map("categories")
}

model SubCategory {
  id                String               @id @default(uuid())
  title             String
  description       String?
  categoryId        String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  products          Product[]
  productLinks      ProductSubCategory[]
  category          Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subSubCategories1 SubSubCategory1[]

  @@index([categoryId])
  @@map("sub_categories")
}

model SubSubCategory1 {
  id                String                   @id @default(uuid())
  title             String
  description       String?
  subCategoryId     String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  products          Product[]
  productLinks      ProductSubSubCategory1[]
  subCategory       SubCategory              @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  subSubCategories2 SubSubCategory2[]

  @@index([subCategoryId])
  @@map("sub_sub_categories_1")
}

model SubSubCategory2 {
  id                String                   @id @default(uuid())
  title             String
  description       String?
  subSubCategory1Id String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  products          Product[]
  productLinks      ProductSubSubCategory2[]
  subSubCategory1   SubSubCategory1          @relation(fields: [subSubCategory1Id], references: [id], onDelete: Cascade)
  subSubCategories3 SubSubCategory3[]

  @@index([subSubCategory1Id])
  @@map("sub_sub_categories_2")
}

model SubSubCategory3 {
  id                String                   @id @default(uuid())
  title             String
  description       String?
  subSubCategory2Id String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  products          Product[]
  productLinks      ProductSubSubCategory3[]
  subSubCategory2   SubSubCategory2          @relation(fields: [subSubCategory2Id], references: [id], onDelete: Cascade)

  @@index([subSubCategory2Id])
  @@map("sub_sub_categories_3")
}

model Product {
  id                     String                   @id @default(uuid())
  productName            String
  description            String?
  PrixVente              Float
  PrixAchat              Float?
  isDepot                Boolean                  @default(false)
  depotPercentage        Float?
  surcharge              Float?                   @default(0)
  gain                   Float?                   @default(0)
  isDispo                Boolean                  @default(true)
  coclientId             String?
  categoryId             String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  instagramLink          String?
  facebookLink           String?
  tiktokLink             String?
  subCategoryId          String?
  /// Unique store barcode for label scanning (EAN-13 style numeric).
  barcode                String?                  @unique
  subSubCategory1Id      String?
  subSubCategory2Id      String?
  subSubCategory3Id      String?
  commandDetails         CommandDetail[]
  featuredSlot           FeaturedProduct?
  photos                 ProductPhoto[]
  category               Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  coClient               CoClient?                @relation(fields: [coclientId], references: [id])
  subCategory            SubCategory?             @relation(fields: [subCategoryId], references: [id])
  subSubCategory1        SubSubCategory1?         @relation(fields: [subSubCategory1Id], references: [id])
  subSubCategory2        SubSubCategory2?         @relation(fields: [subSubCategory2Id], references: [id])
  subSubCategory3        SubSubCategory3?         @relation(fields: [subSubCategory3Id], references: [id])
  likes                  UserLike[]
  ProductCategory        ProductCategory[]
  ProductSubCategory     ProductSubCategory[]
  ProductSubSubCategory1 ProductSubSubCategory1[]
  ProductSubSubCategory2 ProductSubSubCategory2[]
  ProductSubSubCategory3 ProductSubSubCategory3[]

  @@map("products")
}

model FeaturedProduct {
  id        String   @id @default(uuid())
  productId String   @unique
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
  @@map("featured_products")
}

model ProductPhoto {
  id        String   @id @default(uuid())
  photoDoc  String
  idProduct String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [idProduct], references: [id], onDelete: Cascade)

  @@map("multifilesproducts")
}

model Command {
  id               String          @id @default(uuid())
  productsNumber   Int
  PrixVente        Float
  PrixAchat        Float
  status           CommandStatus   @default(NOT_DELIVERED)
  dateLivraison    DateTime?
  adresseLivraison String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  commandDetails   CommandDetail[]

  @@map("commands")
}

model DepositRequest {
  id            String               @id @default(uuid())
  fullName      String
  phoneNumber   String
  proposedPrice Float
  message       String?
  photos        String[]
  status        DepositRequestStatus @default(PENDING)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  userId        String?
  coClientId    String?
  contractDoc   String?
  items         DepositRequestItem[]
  coClient      CoClient?            @relation(fields: [coClientId], references: [id])
  user          User?                @relation(fields: [userId], references: [id])

  @@map("deposit_requests")
}

model DepositRequestItem {
  id                   String         @id @default(uuid())
  depositRequestId     String
  productName          String
  proposedPrice        Float
  commissionPercent    Float?
  priceAfterCommission Float?
  photos               String[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  depositRequest       DepositRequest @relation(fields: [depositRequestId], references: [id], onDelete: Cascade)

  @@index([depositRequestId])
  @@map("deposit_request_items")
}

model CommandDetail {
  id         String    @id @default(uuid())
  commandId  String
  productId  String
  clientId   String?
  coClientId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  client     Client?   @relation(fields: [clientId], references: [id])
  coClient   CoClient? @relation(fields: [coClientId], references: [id])
  command    Command   @relation(fields: [commandId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("command_details")
}

model StoreHour {
  id        String   @id @default(uuid())
  weekday   Weekday  @unique
  isClosed  Boolean  @default(false)
  openTime  String?
  closeTime String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_hours")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ClientFeedback {
  id          String   @id @default(uuid())
  clientName  String
  description String
  rating      Int
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_feedbacks")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String
  linkPath  String?
  entityId  String?
  clientName String?
  clientPhone String?
  orderAddress String?
  productName String?
  productImage String?
  orderPrice Float?
  read      Boolean          @default(false)
  reminderSentAt DateTime?
  createdAt DateTime         @default(now())

  @@index([read, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model HeroCarouselSlide {
  id            String   @id @default(uuid())
  imageDoc      String
  imageDocMobile String?
  imageAlt      String   @default("")
  sortOrder     Int      @default(0)
  isPublished   Boolean  @default(true)
  imageOnly     Boolean  @default(true)
  arabicWelcome String?
  title         String?
  subtitle      String?
  description   String?
  ctaLabel      String?
  ctaHref       String?
  ctaType       String?
  align         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@map("hero_carousel_slides")
}

model SiteSettings {
  id         String   @id @default("default")
  youtubeUrl String?
  updatedAt  DateTime @updatedAt

  @@map("site_settings")
}

enum CommandStatus {
  NOT_DELIVERED
  DELIVERED
  GOT_PROFIT
}

enum UserRole {
  CLIENT
  DEPOSER
  ADMIN
}

enum DepositRequestStatus {
  PENDING
  CONTACTED
  CLOSED
  CONFIRMED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum NotificationType {
  COMMAND_CREATED
  DEPOSIT_REQUEST_CREATED
}
