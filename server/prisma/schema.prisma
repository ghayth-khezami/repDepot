generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id @default(uuid())
  email                String                   @unique
  password             String
  username             String?                  @unique
  /// 8 digits. Orders placed with this number (even before signing up) show in "Mes commandes".
  phoneNumber          String?                  @unique
  isVerified           Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  role                 UserRole                 @default(CLIENT)
  coClient             CoClient?
  depositRequests      DepositRequest[]
  pushSubscriptions    PushSubscription[]
  likes                UserLike[]
  categoryLinks        ProductCategory[]
  subCategoryLinks     ProductSubCategory[]
  subSubCategory1Links ProductSubSubCategory1[]
  subSubCategory2Links ProductSubSubCategory2[]
  subSubCategory3Links ProductSubSubCategory3[]

  @@map("users")
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  User       User?    @relation(fields: [userId], references: [id])
  userId     String?

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductSubCategory {
  productId     String
  subCategoryId String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  User          User?       @relation(fields: [userId], references: [id])
  userId        String?

  @@id([productId, subCategoryId])
  @@index([subCategoryId])
  @@map("product_sub_categories")
}

model ProductSubSubCategory1 {
  productId        String
  subSubCategoryId String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  subSubCategory   SubSubCategory1 @relation(fields: [subSubCategoryId], references: [id], onDelete: Cascade)
  User             User?           @relation(fields: [userId], references: [id])
  userId           String?

  @@id([productId, subSubCategoryId])
  @@index([subSubCategoryId])
  @@map("product_sub_sub_categories_1")
}

model ProductSubSubCategory2 {
  productId        String
  subSubCategoryId String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  subSubCategory   SubSubCategory2 @relation(fields: [subSubCategoryId], references: [id], onDelete: Cascade)
  User             User?           @relation(fields: [userId], references: [id])
  userId           String?

  @@id([productId, subSubCategoryId])
  @@index([subSubCategoryId])
  @@map("product_sub_sub_categories_2")
}

model ProductSubSubCategory3 {
  productId        String
  subSubCategoryId String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  subSubCategory   SubSubCategory3 @relation(fields: [subSubCategoryId], references: [id], onDelete: Cascade)
  User             User?           @relation(fields: [userId], references: [id])
  userId           String?

  @@id([productId, subSubCategoryId])
  @@index([subSubCategoryId])
  @@map("product_sub_sub_categories_3")
}

model PendingUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  username     String?
  phoneNumber  String?
  codeHash     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pending_users")
}

model UserLike {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Client {
  id             String          @id @default(uuid())
  firstName      String
  lastName       String
  address        String
  email          String          @unique
  phoneNumber    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  commandDetails CommandDetail[]

  @@map("clients")
}

model CoClient {
  id              String           @id @default(uuid())
  /// Human-friendly déposant number, used in product refs (D-{number}-{seq}).
  number          Int              @unique @default(autoincrement())
  /// Last product sequence used for this déposant's refs (incremented atomically).
  refSeq          Int              @default(0)
  firstName       String
  lastName        String
  address         String?
  lat             Float?
  lng             Float?
  email           String?          @unique
  /// 8 digits, stored without +216.
  phoneNumber     String           @unique
  RIB             String?
  /// "F" (femme) | "M" (homme) — picks the illustration on cards and the dépôts map.
  gender          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userId          String?          @unique
  user            User?            @relation(fields: [userId], references: [id])
  commandDetails  CommandDetail[]
  depositRequests DepositRequest[]
  products        Product[]
  paymentRequests PaymentRequest[]

  @@map("co_clients")
}

model Category {
  id            String            @id @default(uuid())
  categoryName  String            @unique
  description   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  icon          String?
  coverDoc      String?
  products      Product[]
  productLinks  ProductCategory[]
  subCategories SubCategory[]

  @@map("categories")
}

model SubCategory {
  id                String               @id @default(uuid())
  title             String
  description       String?
  categoryId        String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  products          Product[]
  productLinks      ProductSubCategory[]
  category          Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subSubCategories1 SubSubCategory1[]

  @@index([categoryId])
  @@map("sub_categories")
}

model SubSubCategory1 {
  id                String                   @id @default(uuid())
  title             String
  description       String?
  subCategoryId     String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  products          Product[]
  productLinks      ProductSubSubCategory1[]
  subCategory       SubCategory              @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  subSubCategories2 SubSubCategory2[]

  @@index([subCategoryId])
  @@map("sub_sub_categories_1")
}

model SubSubCategory2 {
  id                String                   @id @default(uuid())
  title             String
  description       String?
  subSubCategory1Id String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  products          Product[]
  productLinks      ProductSubSubCategory2[]
  subSubCategory1   SubSubCategory1          @relation(fields: [subSubCategory1Id], references: [id], onDelete: Cascade)
  subSubCategories3 SubSubCategory3[]

  @@index([subSubCategory1Id])
  @@map("sub_sub_categories_2")
}

model SubSubCategory3 {
  id                String                   @id @default(uuid())
  title             String
  description       String?
  subSubCategory2Id String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  products          Product[]
  productLinks      ProductSubSubCategory3[]
  subSubCategory2   SubSubCategory2          @relation(fields: [subSubCategory2Id], references: [id], onDelete: Cascade)

  @@index([subSubCategory2Id])
  @@map("sub_sub_categories_3")
}

model Product {
  id                     String                   @id @default(uuid())
  productName            String
  description            String?
  PrixVente              Float
  PrixAchat              Float?
  isDepot                Boolean                  @default(false)
  depotPercentage        Float?
  surcharge              Float?                   @default(0)
  gain                   Float?                   @default(0)
  isDispo                Boolean                  @default(true)
  coclientId             String?
  categoryId             String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  instagramLink          String?
  facebookLink           String?
  tiktokLink             String?
  subCategoryId          String?
  /// Unique store barcode for label scanning (EAN-13 style numeric).
  barcode                String?                  @unique
  /// Human-readable unique reference printed on labels and contracts.
  /// Visible on the storefront only once published from the backoffice.
  isPublished            Boolean                  @default(false)
  ref                    String                   @unique @default(dbgenerated("('P-'::text || lpad((nextval('product_ref_seq'::regclass))::text, 5, '0'::text))"))
  status                 ProductStatus            @default(EN_VENTE)
  soldAt                 DateTime?
  payoutStatus           PayoutStatus?
  /// Shop commission in millimes (server-computed for dépôt products).
  shopAmountMillimes     Int?
  /// Déposant share in millimes (server-computed for dépôt products).
  depositorAmountMillimes Int?
  depositRequestId       String?
  /// Set once the déposant has been notified (push) that this article sold.
  soldNotifiedAt         DateTime?
  /// When the déposant was paid for this article (status VENDU + payoutStatus PAYE).
  paidAt                 DateTime?
  /// Set once the déposant has been notified that the payment is ready.
  paidNotifiedAt         DateTime?
  depositRequest         DepositRequest?          @relation(fields: [depositRequestId], references: [id], onDelete: SetNull)
  subSubCategory1Id      String?
  subSubCategory2Id      String?
  subSubCategory3Id      String?
  commandDetails         CommandDetail[]
  featuredSlot           FeaturedProduct?
  photos                 ProductPhoto[]
  category               Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  coClient               CoClient?                @relation(fields: [coclientId], references: [id])
  subCategory            SubCategory?             @relation(fields: [subCategoryId], references: [id])
  subSubCategory1        SubSubCategory1?         @relation(fields: [subSubCategory1Id], references: [id])
  subSubCategory2        SubSubCategory2?         @relation(fields: [subSubCategory2Id], references: [id])
  subSubCategory3        SubSubCategory3?         @relation(fields: [subSubCategory3Id], references: [id])
  likes                  UserLike[]
  ProductCategory        ProductCategory[]
  ProductSubCategory     ProductSubCategory[]
  ProductSubSubCategory1 ProductSubSubCategory1[]
  ProductSubSubCategory2 ProductSubSubCategory2[]
  ProductSubSubCategory3 ProductSubSubCategory3[]

  @@index([status])
  @@index([depositRequestId])
  @@map("products")
}

model FeaturedProduct {
  id        String   @id @default(uuid())
  productId String   @unique
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
  @@map("featured_products")
}

model ProductPhoto {
  id        String   @id @default(uuid())
  photoDoc  String
  idProduct String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [idProduct], references: [id], onDelete: Cascade)

  @@map("multifilesproducts")
}

model Command {
  id               String          @id @default(uuid())
  productsNumber   Int
  PrixVente        Float
  PrixAchat        Float
  status           CommandStatus   @default(NOT_DELIVERED)
  dateLivraison    DateTime?
  /// Set when the shop accepts the order / when it is delivered (customer stepper).
  acceptedAt       DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  adresseLivraison String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  commandDetails   CommandDetail[]

  @@map("commands")
}

model DepositRequest {
  id            String               @id @default(uuid())
  fullName      String
  phoneNumber   String
  proposedPrice Float
  message       String?
  photos        String[]
  status        DepositRequestStatus @default(PENDING)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  userId        String?
  coClientId    String?
  contractDoc   String?
  /// e.g. DV-2026-0143
  contractNumber String?             @unique
  /// Random, unguessable token for the public /suivi page.
  trackingToken  String?             @unique
  durationMonths Int?
  internalNote   String?
  signedAt       DateTime?
  items         DepositRequestItem[]
  products      Product[]
  deposantPushes DeposantPush[]
  coClient      CoClient?            @relation(fields: [coClientId], references: [id])
  user          User?                @relation(fields: [userId], references: [id])

  @@map("deposit_requests")
}

model DepositRequestItem {
  id                   String         @id @default(uuid())
  depositRequestId     String
  productName          String
  proposedPrice        Float
  commissionPercent    Float?
  priceAfterCommission Float?
  photos               String[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  depositRequest       DepositRequest @relation(fields: [depositRequestId], references: [id], onDelete: Cascade)

  @@index([depositRequestId])
  @@map("deposit_request_items")
}

model CommandDetail {
  id         String    @id @default(uuid())
  commandId  String
  productId  String
  clientId   String?
  coClientId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  client     Client?   @relation(fields: [clientId], references: [id])
  coClient   CoClient? @relation(fields: [coClientId], references: [id])
  command    Command   @relation(fields: [commandId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("command_details")
}

model StoreHour {
  id        String   @id @default(uuid())
  weekday   Weekday  @unique
  isClosed  Boolean  @default(false)
  openTime  String?
  closeTime String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_hours")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ClientFeedback {
  id          String   @id @default(uuid())
  clientName  String
  description String
  rating      Int
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_feedbacks")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String
  linkPath  String?
  entityId  String?
  clientName String?
  clientPhone String?
  orderAddress String?
  productName String?
  productImage String?
  orderPrice Float?
  read      Boolean          @default(false)
  reminderSentAt DateTime?
  createdAt DateTime         @default(now())

  @@index([read, createdAt])
  @@map("notifications")
}

/// Anonymous push subscription from the public /suivi page (installed app), per déposant.
model DeposantPush {
  id               String         @id @default(uuid())
  coClientId       String
  depositRequestId String
  endpoint         String         @unique
  p256dh           String
  auth             String
  createdAt        DateTime       @default(now())
  depositRequest   DepositRequest @relation(fields: [depositRequestId], references: [id], onDelete: Cascade)

  @@index([coClientId])
  @@map("deposant_push_subscriptions")
}

/// Every message sent (or attempted) to a déposant about one of their articles.
model DeposantNotification {
  id         String   @id @default(uuid())
  productId  String
  coClientId String
  /// VENDU | PAYE
  event      String
  /// push | email | sms
  channel    String
  /// sent | failed | skipped
  status     String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([coClientId, createdAt])
  @@map("deposant_notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model SiteSettings {
  id           String   @id @default("default")
  youtubeUrl   String?
  shopPhone    String?
  shopWhatsapp String?
  shopAddress  String?
  shopMapsUrl  String?
  /// One condition per line, printed on dépôt contracts.
  contractTerms String?
  updatedAt  DateTime @updatedAt

  @@map("site_settings")
}

enum CommandStatus {
  /// Reçue
  NOT_DELIVERED
  /// Acceptée
  ACCEPTED
  /// Livrée
  DELIVERED
  /// Annulée (articles remis en vente; seule une commande annulée peut être supprimée)
  CANCELLED
  GOT_PROFIT
}

enum UserRole {
  CLIENT
  DEPOSER
  ADMIN
}

enum DepositRequestStatus {
  PENDING
  CONTACTED
  CLOSED
  CONFIRMED
}

enum ProductStatus {
  EN_VENTE
  VENDU
  RETIRE
}

enum PayoutStatus {
  A_PERCEVOIR
  PAYE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum NotificationType {
  COMMAND_CREATED
  DEPOSIT_REQUEST_CREATED
  PAYMENT_REQUEST
}

/// A déposant asks (from the public suivi page) to collect the money of sold articles on a date.
model PaymentRequest {
  id               String    @id @default(uuid())
  coClientId       String
  coClient         CoClient  @relation(fields: [coClientId], references: [id], onDelete: Cascade)
  depositRequestId String?
  productIds       String[]
  amountMillimes   Int
  pickupDate       DateTime
  /// PENDING | DONE | CANCELLED
  status           String    @default("PENDING")
  note             String?
  handledAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([status, pickupDate])
  @@index([coClientId])
  @@map("payment_requests")
}
