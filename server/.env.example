# Required — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

DATABASE_URL=postgresql://user:password@localhost:5432/depot

# Comma-separated allowed browser origins (HTTPS in production)
WEB_URL=http://localhost:3001
CLIENT_URL=http://localhost:5170
MOBILE_URL=http://localhost:5171

# Docker Compose only (docker-compose.prod.yml)
# POSTGRES_PASSWORD=change-me-strong

GOOGLE_CLIENT_ID=

PORT=3000
NODE_ENV=development
