# Public site URL used for canonical links, Open Graph, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://bebedepot.tn

# API base URL — NO /api prefix (products are at /products, not /api/products)
NEXT_PUBLIC_API_URL=https://api.bebedepot.tn

# Local full-stack (Nest on :3000, no CORS issues):
# NEXT_PUBLIC_API_URL=http://localhost:3000

# When using a remote API from localhost:3001, Next.js dev auto-proxies via /api-proxy (no Render CORS change needed).
